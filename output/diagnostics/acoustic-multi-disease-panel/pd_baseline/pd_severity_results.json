{
  "task": "PD severity classification (mild vs moderate/severe)",
  "dataset": "UCI PD Telemonitoring",
  "limitation": "NO healthy controls \u2014 all 42 subjects have PD. This is severity classification, NOT PD detection.",
  "n_subjects": 42,
  "n_recordings": 5875,
  "updrs_threshold": 27.576,
  "features": [
    "Jitter(%)",
    "Jitter(Abs)",
    "Jitter:RAP",
    "Jitter:PPQ5",
    "Jitter:DDP",
    "Shimmer",
    "Shimmer(dB)",
    "Shimmer:APQ3",
    "Shimmer:APQ5",
    "Shimmer:APQ11",
    "Shimmer:DDA",
    "NHR",
    "HNR",
    "RPDE",
    "DFA",
    "PPE"
  ],
  "model": "GradientBoostingClassifier(n_estimators=200, max_depth=4, lr=0.05)",
  "random_seed": 42,
  "splits": {
    "train": {
      "n_samples": 4019,
      "n_subjects": 29
    },
    "val": {
      "n_samples": 813,
      "n_subjects": 6
    },
    "test": {
      "n_samples": 1043,
      "n_subjects": 7
    }
  },
  "metrics": {
    "val_auroc": 0.4677,
    "test_auroc": 0.6487,
    "sensitivity": 0.4493,
    "specificity": 0.7029,
    "ppv": 0.665,
    "npv": 0.493,
    "accuracy": 0.559
  },
  "confusion_matrix": {
    "tn": 317,
    "fp": 134,
    "fn": 326,
    "tp": 266
  },
  "feature_importances": {
    "DFA": 0.1358,
    "Shimmer:APQ11": 0.1239,
    "HNR": 0.112,
    "Jitter(Abs)": 0.104,
    "RPDE": 0.0969,
    "PPE": 0.0753,
    "NHR": 0.0623,
    "Jitter:PPQ5": 0.0487,
    "Shimmer:DDA": 0.0403,
    "Jitter:DDP": 0.0397,
    "Jitter(%)": 0.0353,
    "Shimmer(dB)": 0.028,
    "Shimmer:APQ3": 0.0274,
    "Shimmer": 0.0247,
    "Shimmer:APQ5": 0.0238,
    "Jitter:RAP": 0.022
  }
}